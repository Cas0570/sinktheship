{
  "name": "sinktheship",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "26.8.1",
    "pnpm": "10.33.3"
  },
  "scripts": {
    "dev": "pnpm typecheck && pnpm --filter @sinktheship/web dev",
    "typecheck": "tsc --build",
    "check:boundaries": "node scripts/check-boundaries.mjs && depcruise --config .dependency-cruiser.cjs packages/*/src apps/web/src",
    "test:boundaries": "node --test scripts/boundaries.test.mjs",
    "build": "pnpm typecheck && pnpm check:boundaries && pnpm --filter @sinktheship/web build && pnpm check:production",
    "lint": "eslint . --max-warnings 0 && pnpm check:boundaries",
    "format:check": "node scripts/check-masterprompt.mjs && prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,yaml,yml,html,css}\"",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,yaml,yml,html,css}\" && node scripts/check-masterprompt.mjs",
    "test": "vitest run && pnpm test:boundaries",
    "check:masterprompt": "node scripts/check-masterprompt.mjs",
    "build:test": "vite build --config tests/browser-app/vite.config.mjs",
    "check:production": "node scripts/production-guard.mjs",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --project tests/tsconfig.json",
    "check:browser-retry": "node scripts/check-browser-retry.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sinktheship/eslint-config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.1",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
